{
  "rules": {
    ".read": false,
    ".write": false,

    "content": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'palashansary@gmail.com' && auth.token.email_verified == true"
    },

    "posts": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'palashansary@gmail.com' && auth.token.email_verified == true",
      ".indexOn": ["publishedAt"]
    },

    "postBodies": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'palashansary@gmail.com' && auth.token.email_verified == true"
    },

    "drafts": {
      ".read": "auth != null && auth.token.email == 'palashansary@gmail.com' && auth.token.email_verified == true",
      ".write": "auth != null && auth.token.email == 'palashansary@gmail.com' && auth.token.email_verified == true"
    },

    "adminSettings": {
      ".read": "auth != null && auth.token.email == 'palashansary@gmail.com' && auth.token.email_verified == true",
      ".write": "auth != null && auth.token.email == 'palashansary@gmail.com' && auth.token.email_verified == true"
    },

    "messages": {
      ".read": "auth != null && auth.token.email == 'palashansary@gmail.com' && auth.token.email_verified == true",
      ".indexOn": ["createdAt"],
      "$messageId": {
        ".write": "(auth != null && auth.token.email == 'palashansary@gmail.com' && auth.token.email_verified == true) || (!data.exists() && newData.exists())",
        ".validate": "newData.hasChildren(['name', 'email', 'message'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
        "email": { ".validate": "newData.isString() && newData.val().length <= 200 && newData.val().matches(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/)" },
        "phone": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "number": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "message": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 5000" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "read": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    }
  }
}
