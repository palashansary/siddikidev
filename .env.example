# All optional. Copy to .env.local to override defaults during development.
# The public site needs none of these; the admin panel reads the Firebase web
# config from Firebase Hosting's /__/firebase/init.json when they're unset.

# Firebase web app config (Firebase console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=siddikiansary.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=siddikiansary
VITE_FIREBASE_DATABASE_URL=https://siddikiansary-default-rtdb.firebaseio.com
VITE_FIREBASE_STORAGE_BUCKET=

# Comma-separated Google accounts that can open /admin (UI only; the real
# check is in database.rules.json)
VITE_ADMIN_EMAILS=palashansary@gmail.com

# Set to false to render only src/config/siteContent.js (no database reads)
VITE_REMOTE_CONTENT=true

# Upload defaults (can also be set in Admin → Settings). Put these in
# .env.development.local so they never get baked into a production build.
# The Cloudinary API secret is NOT needed anywhere: uploads use an unsigned preset.
VITE_UPLOAD_PROVIDER=cloudinary
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
